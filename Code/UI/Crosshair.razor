@namespace HvH.UI
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using HvH
@inherits Panel

@* Four ticks and an optional dot. Gap grows with inaccuracy so the crosshair
   tells you what your spread is actually doing. *@

<root class="crosshair">
	@if ( Visible )
	{
		<div class="tick top" style="height: @(Length)px; bottom: @(Gap)px; background-color: @Color;" />
		<div class="tick bottom" style="height: @(Length)px; top: @(Gap)px; background-color: @Color;" />
		<div class="tick left" style="width: @(Length)px; right: @(Gap)px; background-color: @Color;" />
		<div class="tick right" style="width: @(Length)px; left: @(Gap)px; background-color: @Color;" />

		@if ( Settings.CrosshairDot )
		{
			<div class="dot" style="background-color: @Color;" />
		}
	}

	@* Hit marker - four diagonal ticks, shooter-local. Kill and headshot are
	   distinguished by colour AND by the marker growing, so it reads even for
	   someone who cannot separate the colours. *@
	@if ( HitMarker.Visible )
	{
		<div class="hitmarker @MarkerClass" style="opacity: @HitMarker.Fade;">
			<div class="hm tl" style="background-color: @MarkerColor;" />
			<div class="hm tr" style="background-color: @MarkerColor;" />
			<div class="hm bl" style="background-color: @MarkerColor;" />
			<div class="hm br" style="background-color: @MarkerColor;" />
		</div>
	}
</root>

@code {
	// ---- diagnostics -------------------------------------------------------
	// Every live crosshair draws its own hit marker, so if two markers appear at
	// once the question "how many of these exist?" has to be answerable.
	private static readonly List<Crosshair> Instances = new();

	public static int LiveCount => Instances.Count( x => x.IsValid && !x.IsDeleting );

	/// <summary>
	/// How many hit-marker elements are actually alive in the panel tree right
	/// now. This is the number that matters: one marker state can still render
	/// as several elements if old ones outlive a rebuild.
	/// </summary>
	public static int LiveMarkerElements => Instances
		.Where( x => x.IsValid && !x.IsDeleting )
		.SelectMany( x => x.Descendants )
		.Count( d => d.IsValid && ( d.Classes?.Contains( "hitmarker" ) ?? false ) );

	/// <summary>Marker elements including ones already on their way out.</summary>
	public static int MarkerElementsIncludingDeleting => Instances
		.Where( x => x.IsValid )
		.SelectMany( x => x.Descendants )
		.Count( d => d.Classes?.Contains( "hitmarker" ) ?? false );

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( firstTime && !Instances.Contains( this ) )
			Instances.Add( this );
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		Instances.Remove( this );
	}

	private static GameSettings Settings => GameSettings.Current;

	private bool Visible => Player.Local.IsValid() && Player.Local.IsAlive;

	private float Length => Settings.CrosshairLength;
	private string Color => Settings.CrosshairColor.Hex;

	/// <summary>
	/// Static gap plus a dynamic component driven by the weapon's current
	/// inaccuracy, so movement visibly opens the crosshair up.
	/// </summary>
	private float Gap
	{
		get
		{
			var gap = Settings.CrosshairGap;
			if ( !Settings.CrosshairDynamic ) return gap;

			var player = Player.Local;
			var weapon = player?.Inventory?.ActiveWeapon;
			if ( !weapon.IsValid() || !player.Movement.IsValid() ) return gap;

			var stats = weapon.BuildStats();
			if ( stats is null ) return gap;

			var speed = player.Movement.Velocity.WithZ( 0f ).Length;
			var fraction = MathF.Min( 1f, speed / MathF.Max( 1f, player.Movement.RunSpeed ) );
			var spread = stats.Spread + stats.MovementInaccuracy * fraction;

			return gap + spread * 4f;
		}
	}

	private string MarkerColor => HitMarker.ColorFor( HitMarker.Kind ).Hex;

	private string MarkerClass => HitMarker.Kind switch
	{
		HitKind.Kill => "kill",
		HitKind.Headshot => "headshot",
		_ => "body",
	};

	protected override int BuildHash()
		=> HashCode.Combine( Visible, (int)Gap, Length, Color, Settings.CrosshairDot,
			HitMarker.Visible, HitMarker.Kind, (int)( HitMarker.Fade * 10f ) );
}
